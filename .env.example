# WAQT environment variables — copy to .env.local and fill in.

# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# --- Expiry email alerts (server-only; set these in Vercel, not the repo) ---

# Service role key (Supabase -> Project Settings -> API -> service_role). SECRET.
# Lets the scheduled alert job read across companies. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend (https://resend.com -> API Keys). SECRET.
RESEND_API_KEY=your-resend-api-key
# From address. Use a verified domain; onboarding@resend.dev works for testing to your own email.
RESEND_FROM=WAQT <alerts@yourdomain.com>

# Shared secret protecting the cron route (any random string). Vercel Cron sends it.
CRON_SECRET=your-random-secret
